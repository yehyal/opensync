---
import CallbackRedirect from "../components/CallbackRedirect";
import Layout from "../layouts/Layout.astro";
import { DEFAULT_REDIRECT_URI, redirectWithTokens } from "../lib/auth";

const accessToken = Astro.url.searchParams.get("access_token");
const refreshToken = Astro.url.searchParams.get("refresh_token") ?? undefined;
const redirectUri = Astro.url.searchParams.get("redirect_uri") ?? DEFAULT_REDIRECT_URI;
const nextUrl =
  accessToken ? redirectWithTokens(redirectUri, { accessToken, refreshToken }) : null;
---

<Layout title="Redirecting | OpenSync">
  <main class="min-h-screen grid place-items-center px-8 py-10 bg-[radial-gradient(circle_at_top_left,rgba(31,94,255,0.10),transparent_24rem),linear-gradient(180deg,#f8f4ee_0%,#f3efe7_100%)]">
    <section class="w-full max-w-xl p-8 sm:p-10 bg-[#fffdf8]/95 border border-[#d9d0c0] shadow-[0_24px_64px_rgba(22,18,9,0.08)]">
      <p class="m-0 mb-3 text-[0.72rem] tracking-[0.18em] uppercase text-[#6c665d]">OpenSync</p>
      <h1 class="m-0 mb-3 text-[clamp(2rem,6vw,3.2rem)] leading-[0.95] font-semibold">Returning to the desktop app</h1>
      <p class="m-0 mb-6 text-base leading-relaxed text-[#6c665d]">
        {nextUrl
          ? "If the app does not open automatically, use the button below."
          : "Missing token data. Start the login flow again from the desktop app."}
      </p>
      {nextUrl ? <CallbackRedirect client:load nextUrl={nextUrl} /> : <a class="text-[#6c665d] underline underline-offset-4 decoration-[#6c665d]/40" href="/login">Back to login</a>}
    </section>
  </main>
</Layout>
