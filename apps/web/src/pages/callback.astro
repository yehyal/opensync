---
import AuthPageShell from "../components/AuthPageShell.astro";
import CallbackRedirect from "../components/CallbackRedirect";
import Layout from "../layouts/Layout.astro";
import { DEFAULT_REDIRECT_URI, redirectWithTokens } from "../lib/auth";

const accessToken = Astro.url.searchParams.get("access_token");
const refreshToken = Astro.url.searchParams.get("refresh_token") ?? undefined;
const redirectUri = Astro.url.searchParams.get("redirect_uri") ?? DEFAULT_REDIRECT_URI;
const nextUrl =
  accessToken ? redirectWithTokens(redirectUri, { accessToken, refreshToken }) : null;
---

<Layout
  title="Redirecting | OpenSync"
  description="Send the authenticated session back to the OpenSync desktop app."
>
  <AuthPageShell
    title="The browser is done. OpenSync should take it from here."
    description="This last step returns the authenticated session to the desktop app. If the handoff does not happen automatically, there is still a direct path back."
    activeStep="return"
  >
    <section class="auth-card">
      <header class="auth-card__header">
        <p class="section-kicker">Return to app</p>
        <h1 class="auth-card__title">Returning to the desktop app</h1>
        <p class="auth-card__description">
          {
            nextUrl
              ? "The session is ready. OpenSync should reopen automatically, but you can trigger it yourself if needed."
              : "The redirect is missing token data. Start the flow again from the desktop app to create a clean handoff."
          }
        </p>
      </header>

      {
        nextUrl ? (
          <CallbackRedirect client:load nextUrl={nextUrl} />
        ) : (
          <div class="auth-card__footer">
            <p>The browser step could not complete with the current redirect data.</p>
            <a class="auth-link" href="/login">
              Back to login
            </a>
          </div>
        )
      }
    </section>
  </AuthPageShell>
</Layout>
