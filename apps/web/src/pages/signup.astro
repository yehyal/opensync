---
import AuthForm from "../components/AuthForm";
import Layout from "../layouts/Layout.astro";
import { API_BASE_URL, resolveRedirectUri } from "../lib/auth";

const redirectUri = resolveRedirectUri(Astro.url);
const loginHref = `/login?redirect_uri=${encodeURIComponent(redirectUri)}`;
---

<Layout title="Sign up | OpenSync">
  <main class="shell">
    <AuthForm
      client:load
      mode="signup"
      title="Create your OpenSync account"
      description="Minimal account creation for now: name, email, password, then redirect back to the desktop app."
      submitLabel="Create account"
      alternateHref={loginHref}
      alternateLabel="Already have an account? Log in"
      apiBaseUrl={API_BASE_URL}
      redirectUri={redirectUri}
    />
  </main>
</Layout>
