---
import AuthPageShell from "../components/AuthPageShell.astro";
import AuthForm from "../components/AuthForm";
import Layout from "../layouts/Layout.astro";
import { API_BASE_URL, resolveRedirectUri } from "../lib/auth";

const redirectUri = resolveRedirectUri(Astro.url);
const loginHref = `/login?redirect_uri=${encodeURIComponent(redirectUri)}`;
---

<Layout
  title="Sign up | OpenSync"
  description="Create a simple OpenSync account, then hand the session back to the desktop app."
>
  <AuthPageShell
    title="Create a lightweight account, then get back to the app."
    description="OpenSync starts small on purpose. Account creation is intentionally minimal so the desktop handoff stays clear and fast."
    activeStep="account"
  >
    <AuthForm
      client:load
      mode="signup"
      title="Create your OpenSync account"
      description="Name, email, password, then the browser hands the session back to your desktop app."
      submitLabel="Create account"
      alternateHref={loginHref}
      alternateLabel="Log in instead"
      apiBaseUrl={API_BASE_URL}
      redirectUri={redirectUri}
    />
  </AuthPageShell>
</Layout>
