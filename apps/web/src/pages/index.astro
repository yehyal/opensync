---
import Layout from "../layouts/Layout.astro";

const loginUrl = "/login";
const signupUrl = "/signup";
---

<Layout title="OpenSync">
  <main class="min-h-screen grid place-items-center px-8 py-10 bg-[radial-gradient(circle_at_top_left,rgba(31,94,255,0.10),transparent_24rem),linear-gradient(180deg,#f8f4ee_0%,#f3efe7_100%)]">
    <section class="w-full max-w-xl p-8 sm:p-10 bg-[#fffdf8]/95 border border-[#d9d0c0] shadow-[0_24px_64px_rgba(22,18,9,0.08)]">
      <p class="m-0 mb-3 text-[0.72rem] tracking-[0.18em] uppercase text-[#6c665d]">OpenSync</p>
      <h1 class="m-0 mb-3 text-[clamp(2rem,6vw,3.2rem)] leading-[0.95] font-semibold">Clipboard sync for your own devices.</h1>
      <p class="m-0 mb-6 text-base leading-relaxed text-[#6c665d]">
        Sign in from the browser, then jump back to the desktop app with a token.
      </p>
      <div class="flex gap-4 items-center flex-wrap">
        <a class="inline-flex items-center justify-center bg-[#1f5eff] text-white px-5 py-3 no-underline" href={loginUrl}>Log in</a>
        <a class="text-[#6c665d] underline underline-offset-4 decoration-[#6c665d]/40" href={signupUrl}>Create account</a>
      </div>
    </section>
  </main>
</Layout>
