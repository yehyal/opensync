---
import AuthPageShell from "../components/AuthPageShell.astro";
import AuthForm from "../components/AuthForm";
import Layout from "../layouts/Layout.astro";
import { API_BASE_URL, resolveRedirectUri } from "../lib/auth";

const redirectUri = resolveRedirectUri(Astro.url);
const signupHref = `/signup?redirect_uri=${encodeURIComponent(redirectUri)}`;
---

<Layout
  title="Log in | OpenSync"
  description="Authenticate once, then return to the OpenSync desktop app."
>
  <AuthPageShell
    title="Return to your desktop app without making the browser the main event."
    description="Use the same account OpenSync will trust on desktop. Once the session is ready, this page redirects back automatically."
    activeStep="account"
  >
    <AuthForm
      client:load
      mode="login"
      title="Log in to OpenSync"
      description="Keep this step lightweight. Authenticate here, then let the app pick the session back up."
      submitLabel="Log in"
      alternateHref={signupHref}
      alternateLabel="Create an account"
      apiBaseUrl={API_BASE_URL}
      redirectUri={redirectUri}
    />
  </AuthPageShell>
</Layout>
