---
import AuthForm from "../components/AuthForm";
import Layout from "../layouts/Layout.astro";
import { API_BASE_URL, resolveRedirectUri } from "../lib/auth";

const redirectUri = resolveRedirectUri(Astro.url);
const signupHref = `/signup?redirect_uri=${encodeURIComponent(redirectUri)}`;
---

<Layout title="Log in | OpenSync">
  <main class="min-h-screen grid place-items-center px-8 py-10 bg-[radial-gradient(circle_at_top_left,rgba(31,94,255,0.10),transparent_24rem),linear-gradient(180deg,#f8f4ee_0%,#f3efe7_100%)]">
    <AuthForm
      client:load
      mode="login"
      title="Log in to OpenSync"
      description="Use the same account the desktop app will trust. After login, this page redirects back to your app."
      submitLabel="Log in"
      alternateHref={signupHref}
      alternateLabel="Need an account? Sign up"
      apiBaseUrl={API_BASE_URL}
      redirectUri={redirectUri}
    />
  </main>
</Layout>
